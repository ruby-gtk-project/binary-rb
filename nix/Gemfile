# frozen_string_literal: true

# The app's RUNTIME gems, for bundlerEnv in flake.nix. Originally generated by
# converge-port-gem.sh from the gemspec as adwaita + gtk4 alone; rake,
# rubocop and minitest are added by hand on top of that for the reason below,
# so a regeneration that drops them back to the gemspec's runtime-only list
# should restore them rather than leave this bundlerEnv unable to run `rake
# test` or `rake drive` again.
#
# The Gemfile at the repo root is kettle-jem's development bundle — the
# appraisal/changelog/gem-family tooling — and must not end up in a packaged
# app's closure, which is still true of everything in that bundle this one
# does not need.
#
# rake, rubocop and minitest ARE needed here, in the one bundlerEnv this
# Gemfile builds, rather than as nixpkgs' own standalone `rake`/`rubocop`
# packages (the shape rubyPackages_3_4.rspec already uses in flake.nix): a
# standalone rake has no adwaita or minitest in its own gem set, and
# Rake::TestTask's `rake test` and the `sh` calls in `rake drive` both shell
# out to a `ruby` subprocess that inherits whichever `rake` process spawned
# it had as its GEM_HOME. Keeping adwaita/gtk4 and rake/rubocop/minitest in
# the same bundlerEnv is what lets that subprocess still find adwaita.
source "https://rubygems.org"

gem "adwaita"
gem "gtk4"
gem "rake", "~> 13.0"
gem "rubocop", "~> 1.90"
gem "minitest", "~> 5.0"
