#: data/io.github.fizzyizzy05.binary.desktop.in:10
msgid "binary;decimal;hexadecimal;base;convert;"
msgstr "binary;decimal;hexadecimal;base;convert;konverteerimine;konvertimine;kahendsüsteem;binaarsüsteem;binaarne;kümnendsüsteem;detsimaalsüsteem;detsimaalne;kuueteistkümnendsüsteem;heksadetsimaalsüsteem;seksadetsimaalsüsteem;"

#: data/io.github.fizzyizzy05.binary.desktop.in:16
msgid "New Window"
msgstr "Uus aken"

#: data/io.github.fizzyizzy05.binary.metainfo.xml.in:9
msgid ""
"A small and simple app used to convert between different hexadecimal and "
"binary numbers"
msgstr ""
"Lihtne rakendus, mis võimaldab konverteerida numbreid arvusüsteemi aluste "
"vahel (kahendsüsteem, kümnendsüsteem, kuueteistkümnendsüsteem, jne)"

#: data/io.github.fizzyizzy05.binary.metainfo.xml.in:18
msgid "Binary window converting 101010 in binary to 42 in decimal"
msgstr ""
"Binaari aken, kus kuvatakse kahendsüsteemis 101010 konverteerimine "
"kümnendsüsteemis 42-ks"

#: data/io.github.fizzyizzy05.binary.metainfo.xml.in:22
msgid "Binary window converting 1201 in decimal to 4B1 in hexadecimal"
msgstr ""
"Binaari aken, kus kuvatakse kümnendsüsteemis 1201 konverteerimine "
"kuueteistkümnendsüsteem 4B1-ks"

#: data/io.github.fizzyizzy05.binary.metainfo.xml.in:26
msgid "Binary window converting 17 in octal to F in hexadecimal"
msgstr ""
"Binaari aken, kus kuvatakse kaheksandsüsteem 17 konverteerimine "
"kuueteistkümnendsüsteem F-ks"

